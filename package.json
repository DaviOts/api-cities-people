{
  "name": "api-cities-people",
  "type": "module",
  "version": "1.0.0",
  "main": "index.js",
  "author": "ots",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --no-worker-threads",
    "production": "node ./dist/index.js",
    "knex:migrate": "tsx ./node_modules/knex/bin/cli.js --knexfile ./src/server/database/knex/Environment.ts migrate:latest",
    "knex:rollback": "tsx ./node_modules/knex/bin/cli.js --knexfile ./src/server/database/knex/Environment.ts migrate:rollback",
    "knex:rollback-all": "tsx ./node_modules/knex/bin/cli.js --knexfile ./src/server/database/knex/Environment.ts migrate:rollback --all",
    "knex:seed": "tsx ./node_modules/knex/bin/cli.js --knexfile ./src/server/database/knex/Environment.ts seed:run"
  },
  "dependencies": {
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "http-status-codes": "^2.3.0",
    "knex": "^3.1.0",
    "nunjucks": "^3.2.4",
    "sqlite3": "^5.1.7",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.0.0",
    "@eslint/markdown": "^7.5.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.1",
    "@types/nunjucks": "^3.2.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.0.0",
    "eslint-plugin-markdown": "^5.1.0",
    "globals": "^17.3.0",
    "jiti": "^2.6.1",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "@types/jest": "^30.0.0"
  },
  "engines": {
    "node": ">=20.x"
  }
}
